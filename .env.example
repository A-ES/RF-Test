# ─── RF Intelligence Environment Template ─────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5433/rf_intelligence_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5433/rf_intelligence_dev"

# Application Base URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Delivery (SMTP / Nodemailer)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password" # For Gmail: use a 16-character App Password (not your Google password)
EMAIL_FROM="RF Intelligence <your-email@gmail.com>"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Object Storage
S3_BUCKET="documents"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Inngest Background Tasks
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Meta WhatsApp
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
