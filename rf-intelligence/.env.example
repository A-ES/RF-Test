# Supabase — required for Phase 20 (backend / lead management)
# Obtain these values from your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the client bundle.
# Used only in server-side API routes (Phase 20+).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Gmail — required for the contact form (/api/contact).
# GMAIL_USER is the account that sends/receives: Intelligencerf@gmail.com
# GMAIL_APP_PASSWORD is a Google App Password (NOT your normal password):
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to myaccount.google.com > Security > App passwords.
#   3. Create one and paste the 16-character code here (no spaces).
GMAIL_USER=Intelligencerf@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here
