{
  "name": "rf-intelligence-monorepo",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "preinstall": "node -e \"if(process.env.VERCEL){try{require('fs').rmSync('node_modules',{recursive:true,force:true})}catch(e){}}\"",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "inngest:dev": "pnpm --filter @rf-intelligence/dashboard inngest:dev",
    "eval:ask-rf": "pnpm --filter @rf-intelligence/dashboard test run app/ask-rf-eval.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.10.12",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "strictPeerDependencies": false
  }
}
