datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  // Client Conversations roles.
  // CLIENT_ADMIN    — sees every customer in their own organization.
  // CLIENT_EMPLOYEE — sees only the customers assigned to them.
  // ADMIN/MEMBER are the pre-existing dashboard roles and remain org-wide.
  CLIENT_ADMIN
  CLIENT_EMPLOYEE
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  BLOCKED
  COMPLETED
}

enum InsightSeverity {
  CRITICAL
  WARNING
  INFO
}

enum InsightType {
  RISK
  OPPORTUNITY
  ANOMALY
  SUMMARY
}

enum InsightActionStatus {
  ACCEPTED
  DISMISSED
  TASK_CREATED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReportStatus {
  READY
  PROCESSING
  FAILED
}

enum ConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum ConversationType {
  TEAM
  DIRECT
}

// ─── 1. Organization (Tenant) ──────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("Enterprise")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  projects                Project[]
  projectActivities       ProjectActivity[]
  insights                Insight[]
  insightActions          InsightAction[]
  tasks                   Task[]
  documents               Document[]
  reports                 Report[]
  conversations           Conversation[]
  conversationParticipants ConversationParticipant[]
  messages                Message[]
  messageAttachments      MessageAttachment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  askRfQueries            AskRfQuery[]
  auditLogs               AuditLog[]
  invitations             Invitation[]
  inventoryCategories     InventoryCategory[]
  inventoryLocations      InventoryLocation[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  customers               Customer[]
  customerConversations   CustomerConversation[]
  customerMessages        CustomerMessage[]
  messagingInboxes        MessagingInbox[]
  settings                OrganizationSettings?
  subscriptions           Subscription[]

  @@map("organizations")
}

// ─── 2. User ───────────────────────────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String?  // null for demo/seed users; set when an invited user accepts
  role           Role     @default(MEMBER)
  avatarInitials String
  isRFTeam       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedProjects                 Project[]               @relation("ProjectOwner")
  projectActivities             ProjectActivity[]
  assignedTasks                 Task[]                  @relation("TaskAssignee")
  uploadedDocuments             Document[]
  createdReports                Report[]
  sentMessages                  Message[]
  conversationParticipants      ConversationParticipant[]
  notifications                 Notification[]
  notificationPreference        NotificationPreference?
  askRfQueries                  AskRfQuery[]
  auditLogs                     AuditLog[]
  sentInvitations               Invitation[]
  inventoryMovements            InventoryMovement[]
  assignedCustomers             Customer[]              @relation("CustomerAssignee")
  assignedCustomerConversations CustomerConversation[]  @relation("CustomerConversationAssignee")

  @@index([organizationId, role])
  @@map("users")
}

// ─── 3. Project ────────────────────────────────────────────────────────────────
model Project {
  id             String        @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  accountName    String
  status         ProjectStatus @default(ON_TRACK)
  progress       Int           @default(0) // 0 - 100
  dueDate        DateTime
  openTasksCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  activities   ProjectActivity[]
  tasks        Task[]
  documents    Document[]
  reports      Report[]
  insights     Insight[]

  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, dueDate])
  @@map("projects")
}

// ─── 4. ProjectActivity ────────────────────────────────────────────────────────
model ProjectActivity {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  authorId       String
  action         String
  details        String?
  type           String // "status" | "comment" | "task" | "milestone"
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([organizationId, projectId, createdAt])
  @@index([projectId])
  @@map("project_activities")
}

// ─── 5. Insight ────────────────────────────────────────────────────────────────
model Insight {
  id             String          @id @default(cuid())
  organizationId String
  type           InsightType
  severity       InsightSeverity
  title          String
  body           String
  accountName    String?
  ctaHref        String
  ctaLabel       String
  read           Boolean         @default(false)

  // Detailed AI payload (JSON string or structured fields)
  whatHappened      String
  whyDetected       String
  chartTitle        String
  chartType         String // "bar" | "line" | "area"
  chartDataJson     String // JSON array of data points
  businessImpact    String
  recommendedAction String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId    String?
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actions      InsightAction[]

  @@index([organizationId, severity])
  @@index([organizationId, createdAt])
  @@index([projectId])
  @@map("insights")
}

// ─── 6. InsightAction ──────────────────────────────────────────────────────────
model InsightAction {
  id             String              @id @default(cuid())
  organizationId String
  insightId      String
  actionStatus   InsightActionStatus
  performedAt    DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insight      Insight      @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([organizationId, insightId])
  @@map("insight_actions")
}

// ─── 7. Task ───────────────────────────────────────────────────────────────────
model Task {
  id             String     @id @default(cuid())
  organizationId String
  projectId      String?
  assigneeId     String?
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([projectId])
  @@map("tasks")
}

// ─── 8. Document ───────────────────────────────────────────────────────────────
model Document {
  id                     String                   @id @default(cuid())
  organizationId         String
  uploadedById           String
  projectId              String?
  fileName               String
  fileSize               String
  fileUrl                String
  storageKey             String?
  mimeType               String?
  processingStatus       DocumentProcessingStatus @default(PENDING)
  linkedAccount          String?
  extractedEntitiesCount Int                      @default(0)
  metadataJson           String?
  failureReason          String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@map("documents")
}

// ─── 9. Report ─────────────────────────────────────────────────────────────────
model Report {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  projectId      String?
  documentId     String?      @unique
  title          String
  type           String // "QBR Deck" | "Executive Summary" | "Health Scorecard" | "Pipeline Risk"
  accountName    String
  size           String
  status         ReportStatus @default(READY)
  fileUrl        String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@map("reports")
}

// ─── 10. Conversation (Internal Client ↔ RF Team) ──────────────────────────────
model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  topic          String
  contextLabel   String
  rfLead         String
  status         ConversationStatus @default(OPEN)
  type           ConversationType   @default(TEAM)
  unread         Boolean            @default(false)
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, status])
  @@map("conversations")
}

// ─── 10b. ConversationParticipant ──────────────────────────────────────────────
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  organizationId String
  userId         String?
  role           String    @default("MEMBER") // "LEAD" | "MEMBER" | "RF_STAFF"
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([organizationId, userId])
  @@index([conversationId])
  @@map("conversation_participants")
}

// ─── 11. Message ───────────────────────────────────────────────────────────────
model Message {
  id             String              @id @default(cuid())
  organizationId String
  conversationId String
  senderId       String
  isRFTeam       Boolean             @default(false)
  content        String
  messageType    String              @default("TEXT") // "TEXT" | "ATTACHMENT" | "SYSTEM"
  createdAt      DateTime            @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id])
  attachments  MessageAttachment[]

  @@index([organizationId, conversationId, createdAt])
  @@map("messages")
}

// ─── 11b. MessageAttachment ───────────────────────────────────────────────────
model MessageAttachment {
  id             String   @id @default(cuid())
  organizationId String
  messageId      String
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String
  fileUrl        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([organizationId, messageId])
  @@index([storageKey])
  @@map("message_attachments")
}

// ─── 12. Notification ──────────────────────────────────────────────────────────
model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  type           String   @default("GENERAL")
  linkHref       String?
  metadataJson   String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ─── 12b. NotificationPreference (Per-user delivery preferences) ───────────────
model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  organizationId   String
  emailEnabled     Boolean  @default(true)
  inAppEnabled     Boolean  @default(true)
  emailAlerts      Boolean  @default(true)
  riskSignals      Boolean  @default(true)
  weeklyDigest     Boolean  @default(true)
  slackIntegration Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── 13. AskRfQuery (Audit Log of AI Answers) ──────────────────────────────────
model AskRfQuery {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  queryText      String
  answerText     String
  sourcesJson    String // JSON string array of citations
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("ask_rf_queries")
}

// ─── 14. AuditLog ──────────────────────────────────────────────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  metadataJson   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── 15. Invitation ────────────────────────────────────────────────────────────
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  invitedById    String
  email          String
  role           Role             @default(MEMBER)
  token          String           @unique // HMAC-signed token sent in the invite link
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([token])
  @@map("invitations")
}

// ─── Inventory Management Models ─────────────────────────────────────────────

model InventoryCategory {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  items          InventoryItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("inventory_categories")
}

model InventoryLocation {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  isPrimary      Boolean             @default(false)
  stockLevels    InventoryStockLevel[]
  movements      InventoryMovement[]
  createdAt      DateTime            @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("inventory_locations")
}

model InventoryItem {
  id                    String              @id @default(cuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                   String
  barcode               String?
  name                  String
  categoryId            String?
  category              InventoryCategory?  @relation(fields: [categoryId], references: [id])
  unit                  InventoryUnit
  costPrice             Decimal             @db.Decimal(10, 2)
  unitPrice             Decimal             @db.Decimal(10, 2)
  reorderPoint          Int                 @default(0)
  targetStock           Int                 @default(0)
  expiryTrackingEnabled Boolean             @default(false)
  description           String?
  isActive              Boolean             @default(true)
  stockLevels           InventoryStockLevel[]
  movements             InventoryMovement[]
  batches               InventoryBatch[]
  purchaseOrderItems    PurchaseOrderItem[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("inventory_items")
}

model InventoryBatch {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchCode  String?
  quantity   Int
  expiryDate DateTime?
  receivedAt DateTime      @default(now())

  @@index([itemId])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model InventoryStockLevel {
  id         String            @id @default(cuid())
  itemId     String
  item       InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand     Int               @default(0)
  reserved   Int               @default(0)
  updatedAt  DateTime          @updatedAt

  @@unique([itemId, locationId])
  @@index([locationId])
  @@map("inventory_stock_levels")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem         @relation(fields: [itemId], references: [id])
  locationId     String
  location       InventoryLocation     @relation(fields: [locationId], references: [id])
  type           InventoryMovementType
  quantity       Int
  reason         String?
  reference      String?
  notes          String?
  performedById  String
  performedBy    User                  @relation(fields: [performedById], references: [id])
  timestamp      DateTime              @default(now())

  @@index([organizationId, timestamp])
  @@index([itemId])
  @@map("inventory_movements")
}

model Supplier {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  email          String?
  phone          String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  items          PurchaseOrderItem[]
  expectedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

enum InventoryUnit {
  PCS
  KG
  G
  PACKS
  LITRES
  ML
  UNITS
}

enum InventoryMovementType {
  RECEIPT
  SHIPMENT
  TRANSFER
  ADJUSTMENT
  RETURN
  WASTAGE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ─── 16. Customer Conversations (Part 1) ────────────────────────────────────────

enum CustomerStatus {
  LEAD
  ACTIVE
  AT_RISK
  CHURNED
  INACTIVE
}

enum CustomerConversationChannel {
  WHATSAPP
  EMAIL
  WEB_CHAT
  SMS
}

enum CustomerConversationStatus {
  OPEN
  AI_HANDLING
  WAITING_FOR_CUSTOMER
  WAITING_FOR_CLIENT
  HUMAN_ESCALATION
  RESOLVED
  CLOSED
}

enum CustomerConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustomerMessageSender {
  CUSTOMER
  AI
  EMPLOYEE
}

model Customer {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  company            String?
  email              String?
  phone              String?
  whatsapp           String?
  status             CustomerStatus @default(LEAD)
  tagsJson           String // JSON string array of tags
  internalNotes      String?
  orderReference     String? // purchase/order history reference
  // Visibility: a CLIENT_EMPLOYEE only sees customers assigned to them; a
  // CLIENT_ADMIN sees every customer in their organization.
  assignedEmployeeId String?
  lastInteractionAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedEmployee User?                  @relation("CustomerAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  conversations    CustomerConversation[]

  @@index([organizationId, status])
  @@index([organizationId, assignedEmployeeId])
  @@index([organizationId, lastInteractionAt])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@unique([organizationId, whatsapp])
  @@map("customers")
}

model CustomerConversation {
  id                 String                       @id @default(cuid())
  organizationId     String
  customerId         String
  channel            CustomerConversationChannel
  status             CustomerConversationStatus   @default(OPEN)
  priority           CustomerConversationPriority @default(NORMAL)
  subject            String?
  tagsJson           String // JSON string array of tags
  assignedEmployeeId String?
  lastMessageAt      DateTime                     @default(now())
  lastMessagePreview String?
  resolvedAt         DateTime?
  closedAt           DateTime?
  escalationReason   String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedEmployee User?             @relation("CustomerConversationAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  messages         CustomerMessage[]

  @@index([organizationId, status])
  @@index([organizationId, channel])
  @@index([organizationId, customerId])
  @@index([organizationId, assignedEmployeeId])
  @@index([organizationId, lastMessageAt])
  @@map("customer_conversations")
}

model CustomerMessage {
  id              String                @id @default(cuid())
  organizationId  String
  conversationId  String
  sender          CustomerMessageSender
  body            String
  // Model confidence for the reply the AI drafted. Non-null only for AI messages.
  confidenceScore Float?
  // Provider-issued id (e.g. WhatsApp wamid). Used to ignore webhook retries.
  providerMessageId String?
  createdAt       DateTime              @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation CustomerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerMessageId])
  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("customer_messages")
}

// ─── Messaging inboxes (channel → Organization routing) ───────────────────────
//
// Organization resolution for inbound webhooks:
//   Each tenant that receives customer messages owns one or more inboxes.
//   WhatsApp: `externalAddress` is Meta's `metadata.phone_number_id` (the
//   Cloud API id of the business number, not the human-readable E.164).
//   Email (later): `externalAddress` will be the inbound mailbox, lowercased.
//   The webhook never trusts a client-supplied organizationId. It looks up
//   (provider, externalAddress) here and uses the organizationId on that row.
enum MessagingProviderKind {
  WHATSAPP
  EMAIL
}

model MessagingInbox {
  id              String                 @id @default(cuid())
  organizationId  String
  provider        MessagingProviderKind
  externalAddress String
  displayLabel    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalAddress])
  @@index([organizationId, provider])
  @@map("messaging_inboxes")
}

// ─── RF Admin Console Identity (top-level, deliberately NOT tenant-scoped) ──────
//
// This is the RF Intelligence staff identity that signs into the RF Admin console.
// It is intentionally a separate table from `users` and carries NO organizationId:
// RF admins span every tenant, so putting them in the tenant RLS scope would be
// wrong. It is also deliberately NOT reachable by promotion — there is no role
// flag or boolean anywhere on `User` that can turn a client user into an RF admin.
// The only way in is `rf_admin_session`, which is minted solely by
// POST /api/auth/rf-admin/login and is only ever resolved against this table.
// If you are adding a field here, do not add an `organizationId`.
model RfAdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // ── Multi-factor authentication (TOTP / RFC 6238) ──────────────────────────
  // A TOTP secret must be recoverable — the server needs it to recompute the
  // expected code — so unlike a password it cannot be hashed. It is encrypted
  // at rest with AES-256-GCM under RF_ADMIN_MFA_ENCRYPTION_KEY instead.
  mfaEnabled          Boolean   @default(false)
  mfaSecretCiphertext String?
  mfaEnrolledAt       DateTime?

  // Brute-force and replay defences. `mfaLastUsedStep` records the highest TOTP
  // time-step already spent, so a code cannot be replayed inside its window.
  mfaFailedAttempts Int      @default(0)
  mfaLockedUntil    DateTime?
  mfaLastUsedStep   Int?
  lastFailedLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rf_admin_users")
}

// ─── 17. Billing ───────────────────────────────────────────────────────────────

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

// A catalog tier. Not tenant-scoped: plans are global and shared by every
// organization, so there is deliberately no organizationId here.
model Plan {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  priceCents    Int
  currency      String          @default("USD")
  interval      BillingInterval @default(MONTHLY)
  seatLimit     Int?
  customerLimit Int?
  featuresJson  String          @default("[]") // JSON string array of feature keys
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  seats                  Int                @default(1)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@unique([organizationId])
  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ─── 18. OrganizationSettings (per-org AI + feature configuration) ─────────────
//
// Prompt 3.3 reads the AI model, prompts, and both thresholds from here. It
// must not hardcode them. The dashboard and the admin console both read this
// row; only the admin console may write it.
model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  // ── AI model configuration ────────────────────────────────────────────────
  aiProvider     String  @default("deepseek")
  aiModel        String  @default("deepseek-chat")
  aiTemperature  Float   @default(0.2)
  aiMaxTokens    Int     @default(2048)
  aiSystemPrompt String  @default("You are a helpful sales operations assistant for RF Intelligence.")
  // Retrieval grounding: how much retrieved context to include.
  aiContextWindow Int     @default(6)

  // ── Thresholds (0..1) ─────────────────────────────────────────────────────
  // AI replies below confidenceThreshold are withheld pending human review.
  confidenceThreshold Float @default(0.75)
  // AI replies below escalationThreshold trigger HUMAN_ESCALATION.
  escalationThreshold Float @default(0.6)

  // ── Behaviour + feature flags ─────────────────────────────────────────────
  autoReplyEnabled   Boolean @default(true)
  featureFlagsJson   String  @default("{}") // JSON object of boolean feature flags
  dataRetentionDays  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// ─── 19. AdminAuditLog (RF Admin console, deliberately NOT tenant-scoped) ──────
//
// Cross-tenant by nature: it records what RF staff did, which may span or
// predate any particular organization. `organizationId` is therefore a plain
// string with NO foreign key, so the audit trail survives tenant deletion —
// a cascade here would let a deleted org erase the record of who touched it.
model AdminAuditLog {
  id      String  @id @default(cuid())
  adminId String? // null when the action had no resolvable admin (e.g. a failed login for an unknown email)
  action         String
  entityType     String
  entityId       String?
  organizationId String? // affected tenant, when the action was tenant-scoped
  targetEmail    String? // for actions taken against a specific person
  metadataJson   String?
  ipAddress      String?
  userAgent      String?
  succeeded      Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Deliberately NO foreign key to RfAdminUser, for the same reason as
  // organizationId above: a failed login against an unknown email must still be
  // recordable (adminId is then null), and an audit row must not be cascaded away
  // when the staff account behind it is deleted. The console credential can only
  // INSERT here, so there is no referential-integrity requirement to satisfy.
  @@index([adminId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}
