# ─── Inngest (Background Orchestration) ───────────────────────────────────────
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Razorpay Payment Integration ─────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_yourkeyid"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
