# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5433/rf_intelligence_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5433/rf_intelligence_dev"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── DeepSeek AI ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY="your-deepseek-api-key"
