# RF Admin console environment. Copy to .env.local for local development, and
# set the same keys in the admin Vercel project (separate from the dashboard's).
#
# Apps/admin reads NONE of the dashboard's variables. In particular it does not
# read DATABASE_URL: it resolves ADMIN_DATABASE_URL via the RF_APP=admin switch
# (set automatically in next.config.ts and the ts-node scripts). Do not add
# DATABASE_URL here — its presence would be a sign this environment was copied
# from the dashboard, which is exactly the mix-up the separate role prevents.

# ─── Identity ──────────────────────────────────────────────────────────────────
# Signs the admin session HMAC. MUST be different from the dashboard's
# AUTH_SECRET: sharing a key would let a token minted by one app verify in the
# other. Generate with: openssl rand -base64 32
RF_ADMIN_SESSION_SECRET=""

# AES-256 key (exactly 32 bytes, base64) used to encrypt TOTP secrets at rest.
# Generate with: openssl rand -base64 32
# Rotating this invalidates every enrolled authenticator and requires re-enrolment.
RF_ADMIN_MFA_ENCRYPTION_KEY=""

# ─── Database (apps/admin ONLY) ────────────────────────────────────────────────
# The dedicated cross-tenant role, created by packages/db/prisma/admin-role.sql.
# This credential must never appear in the dashboard's environment.
# Port 5432 (direct), NOT 6543 — the admin role bypasses RLS, and a direct
# connection keeps that independent of pooler session semantics.
ADMIN_DATABASE_URL="postgresql://rf_admin_app:REPLACE@db-host:5432/postgres?sslmode=require"

# ─── Access control ────────────────────────────────────────────────────────────
# Comma-separated IPs or CIDR ranges allowed to reach this app at all.
# Unset in production => deny every request (fail closed).
# Unset in development => allow any address, so `pnpm dev` works without setup.
# That development fallback is deliberately permissive and must never be relied
# on: set a list (e.g. "127.0.0.1,::1") if the dev server is reachable beyond
# your machine.
ADMIN_IP_ALLOWLIST=""
