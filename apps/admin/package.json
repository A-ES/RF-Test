{
  "name": "@rf-intelligence/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "prebuild": "pnpm --filter @rf-intelligence/db db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "RF_APP=admin ts-node --project tsconfig.scripts.json scripts/create-admin.ts",
    "admin:enrol-mfa": "RF_APP=admin ts-node --project tsconfig.scripts.json scripts/enrol-mfa.ts"
  },
  "dependencies": {
    "@rf-intelligence/db": "workspace:*",
    "@rf-intelligence/ui": "workspace:*",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "ts-node": "^10.9.2"
  }
